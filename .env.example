# OpenAI-compatible endpoint. Use local credentials; never commit .env.
API_KEY=replace-with-your-key
MODEL=replace-with-your-model
BASE_URL=https://api.example.invalid/v1
# Local remains the default. Docker requires a prepared image and running engine.
MOKIO_EXECUTION_BACKEND=local
MOKIO_DOCKER_IMAGE=mokioclaw-execution:0.2.0
# Product defaults remain full / single approval. Eval has its own fixed profile.
MOKIO_WORKFLOW_MODE=full
MOKIO_APPROVAL_MODE=inline
