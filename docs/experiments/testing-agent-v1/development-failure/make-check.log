    def test_real_workflow_modes_produce_same_verified_file(tmp_path, local_models, mode):
        (tmp_path / "app.txt").write_text("before")
        events = list(
            stream_agent_events(
                "将 app.txt 的 before 改成 after",
                workspace=tmp_path,
                workflow_mode=mode,
                approval_mode="deny",
            )
        )
        assert (tmp_path / "app.txt").read_text() == "after"
        terminal = [
            row["event"]
            for row in events
