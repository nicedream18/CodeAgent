+_TZ_SUFFIX = re.compile(r"(?:[Zz]|[+-]\d{2}:?\d{2})$")
+
+
+def parse_since(value: str) -> datetime:
+    """Parse a ``--since`` ISO8601 value into an aware UTC datetime.
+
+    A timezone designator (``Z`` or a ``+HH:MM``/``-HH:MM`` offset) is required;
+    naive values are rejected so the comparison is unambiguous. Raises
+    ``ValueError`` for anything unparsable or timezone-less.
+    """
+    text = (value or "").strip()
+    if not text:
+        raise ValueError("empty timestamp")
+    if not _TZ_SUFFIX.search(text):
+        raise ValueError("timestamp must include a timezone (Z or UTC offset)")
+    normalized = text[:-1] + "+00:00" if text[-1] in "Zz" else text
+    try:
+        parsed = datetime.fromisoformat(normalized)
+    except ValueError as exc:
+        raise ValueError(f"invalid ISO8601 timestamp: {value!r}") from exc
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise ValueError("timestamp must include a timezone (Z or UTC offset)")
+    return parsed.astimezone(UTC)
+
+
+def parse_record_timestamp(value: Any) -> datetime | None:
+    """Return a record timestamp as aware UTC, or ``None`` when missing/invalid.
+
+    Records are written with ``datetime.now(UTC).isoformat()`` (``+00:00``
+    suffix). Legacy records may lack a timestamp or carry a naive value; a naive
+    value is interpreted as UTC rather than dropped.
+    """
+    if not isinstance(value, str):
+        return None
+    text = value.strip()
+    if not text:
+        return None
+    normalized = text[:-1] + "+00:00" if text[-1] in "Zz" else text
+    try:
+        parsed = datetime.fromisoformat(normalized)
+    except ValueError:
+        return None
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        return parsed.replace(tzinfo=UTC)
+    return parsed.astimezone(UTC)
+
+
+def record_at_or_after(record: dict[str, Any], since: datetime) -> bool:
+    """True when ``record`` has a valid timestamp at or after ``since`` (UTC)."""
+    stamp = parse_record_timestamp(record.get("timestamp"))
+    if stamp is None:
+        return False
+    return stamp >= since
+
