+def _parse_iso_utc(value: str) -> datetime:
+    """Parse an ISO8601 timestamp that must carry ``Z`` or an explicit UTC offset."""
+    from datetime import datetime
+
+    text = value.strip()
+    if text[-1:] in {"Z", "z"}:
+        text = text[:-1] + "+00:00"
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError as exc:
+        raise ValueError(f"invalid ISO8601 timestamp: {value!r}") from exc
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise ValueError(f"timestamp must include a timezone (Z or UTC offset): {value!r}")
+    return parsed
+
+
+def _parse_since(value: str | None) -> datetime | None:
+    """Validate ``--since``; raise ``typer.BadParameter`` (usage error) when invalid."""
+    if value is None:
+        return None
+    from datetime import UTC
+
+    try:
+        return _parse_iso_utc(value).astimezone(UTC)
+    except ValueError as exc:
+        raise typer.BadParameter(str(exc), param_hint="--since") from exc
+
+
+def _record_at_or_after(record: dict, since_utc: datetime) -> bool:
+    """True when the record timestamp is valid and not earlier than ``since_utc``."""
+    from datetime import UTC
+
+    raw = record.get("timestamp")
+    if not isinstance(raw, str) or not raw.strip():
+        return False
+    try:
+        parsed = _parse_iso_utc(raw)
+    except ValueError:
+        return False
+    return parsed.astimezone(UTC) >= since_utc
+
