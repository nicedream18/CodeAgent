[0, "o", "\u001b[2J\u001b[HMokioAgent | 产物通过、运行失败：诊断回放\nM08-v2-full-1\n这是已归档记录的回放，不是一次新的实时模型运行。\n\n"]
[12, "o", "\u001b[2J\u001b[H需求与来源\n为 mokioclaw trace 增加 --since ISO8601 时间过滤，要求带 Z 或 UTC 偏移、包含边界时刻并按 UTC 比较。不合法或没有时区的参数返回 CLI 用法错误，不能启动任何运行。旧记录无时间戳或时间戳无效时，在有 --since 条件下跳过；无该参数时仍保持原输出。--follow 与其他筛选可组合。\n\n本工作区是固定工程任务切片，不是原仓库的完整测试环境。可见基础检查命令：PYTHONPATH=src:. python -m pytest -q tests/test_visible_basics.py。该检查验证基础读写/搜索、CLI 帮助和本地 stdio fixture；目标边界请自行验证。隐藏目标及固定回归由外部评分器在全新离线容器重建。只修改 src/mokioclaw 下实现，保留测试和示例 fixture。\nbase: 6e88c21c294fe041a821a21e0abad9dc095b9364\n"]
[32, "o", "\u001b[2J\u001b[H仓库证据（checkpoint 摘要）\nTODO.md\nsrc/mokioclaw/cli/app.py\nsrc/mokioclaw/core/transport_trace.py\n完整模型请求、读取与调用证据保存在同一 trial 的 trace.tar.gz。\n"]
[52, "o", "\u001b[2J\u001b[H实际候选 diff\n--- a/src/mokioclaw/cli/app.py\n+++ b/src/mokioclaw/cli/app.py\n@@ -439,12 +439,27 @@\n     direction: str | None = None,\n     follow: bool = False,\n     raw: bool = False,\n+    since: str | None = typer.Option(\n+        None,\n+        \"--since\",\n+        help=\"Only show records at or after this ISO8601 time (UTC 'Z' or offset required).\",\n+    ),\n ) -> None:\n     \"\"\"Read existing traces, optionally following new records; never execute work.\"\"\"\n     import time\n \n     from mokioclaw.core.daemon_client import daemon_state_dir\n-    from mokioclaw.core.transport_trace import TraceReader\n+    from mokioclaw.core.transport_trace import TraceReader, parse_since, record_at_or_after\n+\n+    since_at = None\n+    if since is not None:\n+        try:\n+            since_at = parse_since(since)\n+        except ValueError as exc:\n+            raise typer.BadParameter(\n+                f\"{exc}; expected ISO8601 with 'Z' or a UTC offset, e.g. 2024-01-01T00:00:00Z\",\n+                param_hint=\"--since\",\n+            ) from exc\n \n     reader = TraceReader()\n     try:\n@@ -456,6 +471,8 @@\n                 if layer and record.get(\"layer\", \"event\") != layer:\n                     continue\n                 if direction and record.get(\"direction\", \"CORE\") != direction:\n+                    continue\n+                if since_at is not None and not record_at_or_after(record, since_at):\n                     continue\n                 if raw:\n                     typer.echo(json.dumps(record, ensure_ascii=False))\n--- a/src/mokioclaw/core/transport_trace.py\n+++ b/src/mokioclaw/core/transport_trace.py\n@@ -3,6 +3,7 @@\n from __future__ import annotations\n \n import json\n+import re\n import threading\n from collections.abc import Iterator\n from datetime import UTC, datetime\n@@ -111,6 +112,61 @@\n                     continue\n \n \n+_TZ_SUFFIX = re.compile(r\"(?:[Zz]|[+-]\\d{2}:?\\d{2})$\")\n+\n+\n+def parse_since(value: str) -> datetime:\n+    \"\"\"Parse a ``--since`` ISO8601 value into an aware UTC datetime.\n+\n+    A timezone designator (``Z`` or a ``+HH:MM``/``-HH:MM`` offset) is required;\n+    naive values are rejected so the comparison is unambiguous. Raises\n+    ``ValueError`` for anything unparsable or timezone-less.\n+    \"\"\"\n+    text = (value or \"\").strip()\n+    if not text:\n+        raise ValueError(\"empty timestamp\")\n+    if not _TZ_SUFFIX.search(text):\n+        raise ValueError(\"timestamp must include a timezone (Z or UTC offset)\")\n+    normalized = text[:-1] + \"+00:00\" if text[-1] in \"Zz\" else text\n+    try:\n+        parsed = datetime.fromisoformat(normalized)\n+    except ValueError as exc:\n+        raise ValueError(f\"invalid ISO8601 timestamp: {value!r}\") from exc\n+    if parsed.tzinfo is None or parsed.utcoffset() is None:\n+        raise ValueError(\"timestamp must include a timezone (Z or UTC offset)\")\n+    return parsed.astimezone(UTC)\n+\n+\n+def parse_record_timestamp(value: Any) -> datetime | None:\n+    \"\"\"Return a record timestamp as aware UTC, or ``None`` when missing/invalid.\n+\n+    Records are written with ``datetime.now(UTC).isoformat()`` (``+00:00``\n+    suffix). Legacy records may lack a timestamp or carry a naive value; a naive\n+    value is interpreted as UTC rather than dropped.\n+    \"\"\"\n+    if not isinstance(value, str):\n+        return None\n+    text = value.strip()\n+    if not text:\n+        return None\n+    normalized = text[:-1] + \"+00:00\" if text[-1] in \"Zz\" else text\n+    try:\n+        parsed = datetime.fromisoformat(normalized)\n+    except ValueError:\n+        return None\n+    if parsed.tzinfo is None or parsed.utcoffset() is None:\n+        return parsed.replace(tzinfo=UTC)\n+    return parsed.astimezone(UTC)\n+\n+\n+def record_at_or_after(record: dict[str, Any], since: datetime) -> bool:\n+    \"\"\"True when ``record`` has a valid timestamp at or after ``since`` (UTC).\"\"\"\n+    stamp = parse_record_timestamp(record.get(\"timestamp\"))\n+    if stamp is None:\n+        return False\n+    return stamp >= since\n+\n+\n class TraceReader:\n     \"\"\"Incremental reader with one cursor per file, never one key per event.\"\"\"\n \n\n"]
