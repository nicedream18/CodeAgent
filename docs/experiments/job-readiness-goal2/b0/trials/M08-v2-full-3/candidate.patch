+def _parse_iso8601_utc(value: str, *, require_timezone: bool) -> datetime | None:
+    """Parse an ISO8601 string into an aware UTC datetime.
+
+    Returns ``None`` when the value cannot be parsed. When ``require_timezone``
+    is true, values without a timezone designator (``Z``/``z`` or a ``+HH:MM``
+    style offset) are rejected as well.
+    """
+    text = value.strip()
+    if not text:
+        return None
+    if text[-1] in {"Z", "z"}:
+        text = text[:-1] + "+00:00"
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError:
+        return None
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        if require_timezone:
+            return None
+        return parsed.replace(tzinfo=UTC)
+    return parsed.astimezone(UTC)
+
+
+def _parse_since_option(value: str | None) -> datetime | None:
+    """Validate the ``--since`` CLI value, raising a usage error when invalid."""
+    if value is None:
+        return None
+    parsed = _parse_iso8601_utc(value, require_timezone=True)
+    if parsed is None:
+        raise typer.BadParameter(
+            f"Invalid --since value {value!r}: expected an ISO8601 timestamp with a "
+            "timezone, e.g. 2024-01-01T00:00:00Z or 2024-01-01T00:00:00+02:00."
+        )
+    return parsed
+
+
+def _record_timestamp_utc(record: dict) -> datetime | None:
+    """Return the record's timestamp as an aware UTC datetime, or ``None``."""
+    raw = record.get("timestamp")
+    if not isinstance(raw, str):
+        return None
+    return _parse_iso8601_utc(raw, require_timezone=False)
+
