+def _parse_iso8601_utc(value: str) -> "datetime":
+    """Parse an ISO8601 string that must carry a timezone; return it in UTC."""
+    from datetime import UTC, datetime
+
+    text = value.strip()
+    if text.endswith(("Z", "z")):
+        text = text[:-1] + "+00:00"
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError as exc:
+        raise ValueError(f"invalid ISO8601 timestamp: {value!r}") from exc
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise ValueError(f"timestamp must include a timezone: {value!r}")
+    return parsed.astimezone(UTC)
+
+
+def _parse_since(value: str) -> "datetime":
+    """Parse the ``--since`` option, raising ``typer.BadParameter`` when invalid."""
+    try:
+        return _parse_iso8601_utc(value)
+    except ValueError as exc:
+        raise typer.BadParameter(
+            f"--since must be an ISO8601 timestamp with a timezone (e.g. 2024-01-01T00:00:00Z): {exc}"
+        ) from exc
+
+
+def _record_at_or_after(record: dict, since_utc: "datetime") -> bool:
+    """Return True when the record timestamp is valid and >= ``since_utc`` (UTC)."""
+    timestamp = record.get("timestamp")
+    if not isinstance(timestamp, str):
+        return False
+    try:
+        record_utc = _parse_iso8601_utc(timestamp)
+    except ValueError:
+        return False
+    return record_utc >= since_utc
+
