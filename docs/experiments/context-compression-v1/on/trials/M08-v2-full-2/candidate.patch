+def _parse_iso8601_utc(value: str) -> datetime | None:
+    """Parse an ISO8601 timestamp that carries ``Z`` or a UTC offset.
+
+    Returns an aware datetime normalized to UTC, or ``None`` when the value is
+    malformed or lacks timezone information.
+    """
+    if not isinstance(value, str):
+        return None
+    text = value.strip()
+    if not text:
+        return None
+    if text.endswith(("Z", "z")):
+        text = text[:-1] + "+00:00"
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError:
+        return None
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        return None
+    return parsed.astimezone(UTC)
+
