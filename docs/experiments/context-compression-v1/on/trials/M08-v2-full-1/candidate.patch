+_SINCE_FORMAT_HINT = (
+    "expected an ISO8601 timestamp with a timezone, e.g. "
+    "2024-01-01T00:00:00Z or 2024-01-01T01:00:00+01:00"
+)
+
+
+def _parse_since(value: str) -> datetime:
+    """Parse ``--since`` strictly: ISO8601 that must carry ``Z`` or a UTC offset."""
+    text = (value or "").strip()
+    if not text:
+        raise typer.BadParameter(f"--since must not be empty; {_SINCE_FORMAT_HINT}")
+    normalized = text
+    if normalized[-1] in {"Z", "z"}:
+        normalized = normalized[:-1] + "+00:00"
+    try:
+        parsed = datetime.fromisoformat(normalized)
+    except ValueError:
+        raise typer.BadParameter(f"--since is not a valid ISO8601 timestamp: {value!r}; {_SINCE_FORMAT_HINT}") from None
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise typer.BadParameter(
+            f"--since requires an explicit timezone (Z or UTC offset): {value!r}; {_SINCE_FORMAT_HINT}"
+        )
+    return parsed.astimezone(timezone.utc)
+
+
+def _parse_record_timestamp(value: object) -> datetime | None:
+    """Parse a record timestamp; naive values are treated as UTC. ``None`` if invalid."""
+    if not isinstance(value, str):
+        return None
+    text = value.strip()
+    if not text:
+        return None
+    if text[-1] in {"Z", "z"}:
+        text = text[:-1] + "+00:00"
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError:
+        return None
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        return parsed.replace(tzinfo=timezone.utc)
+    return parsed.astimezone(timezone.utc)
+
+
+def _record_at_or_after(record: dict, since_utc: datetime) -> bool:
+    """True when the record timestamp is at or after ``since_utc`` (UTC, inclusive)."""
+    record_ts = _parse_record_timestamp(record.get("timestamp"))
+    if record_ts is None:
+        return False
+    return record_ts >= since_utc
+
