+def _parse_aware_iso8601(value: str) -> datetime:
+    """Parse an ISO8601 string that must carry a timezone; return aware UTC datetime."""
+    if not isinstance(value, str):
+        raise ValueError("timestamp must be a string")
+    text = value.strip()
+    if not text:
+        raise ValueError("timestamp is empty")
+    if text.endswith(("Z", "z")):
+        text = text[:-1] + "+00:00"
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError as exc:
+        raise ValueError(f"invalid ISO8601 timestamp: {value!r}") from exc
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise ValueError(f"timestamp is missing a timezone: {value!r}")
+    return parsed.astimezone(UTC)
+
+
+def parse_since(value: str) -> datetime:
+    """Parse a ``--since`` boundary; requires a timezone (``Z`` or UTC offset)."""
+    return _parse_aware_iso8601(value)
+
+
+def record_is_at_or_after(record: dict[str, Any], since_utc: datetime) -> bool:
+    """True when the record timestamp is at or after ``since_utc`` (UTC compare).
+
+    Records with a missing, empty, or unparsable timestamp are excluded.
+    """
+    raw = record.get("timestamp") if isinstance(record, dict) else None
+    if not isinstance(raw, str) or not raw.strip():
+        return False
+    try:
+        record_dt = _parse_aware_iso8601(raw)
+    except ValueError:
+        return False
+    return record_dt >= since_utc
+
+
 class TraceReader:
     """Incremental reader with one cursor per file, never one key per event."""
 
